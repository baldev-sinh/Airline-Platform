# nginx configuration for the production web app container.
#
# This is a TEMPLATE: when the container starts, the nginx image replaces ${API_GATEWAY_URL} with
# the environment variable of that name (default set in the Dockerfile) and writes the result to
# /etc/nginx/conf.d/default.conf. Only variables that exist in the environment are replaced, so
# nginx's own variables like $uri and $request_id are left alone.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    server_tokens off;              # don't advertise the nginx version
    client_max_body_size 1m;        # the API only receives small JSON bodies

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;
    gzip_min_length 1024;

    # ---- Health check for Docker / Kubernetes probes ----
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # ---- API: forwarded to the API gateway, so the browser only ever talks to one origin ----
    location /api/ {
        proxy_pass ${API_GATEWAY_URL};
        include /etc/nginx/snippets/proxy.conf;
    }

    location /auth/ {
        proxy_pass ${API_GATEWAY_URL};
        include /etc/nginx/snippets/proxy.conf;
    }

    # ---- Source maps are for the error tracker, never for the public ----
    location ~* \.map$ {
        return 404;
    }

    # ---- Built files with a content hash in their name (main-AB12CD.js) ----
    # The name changes whenever the content does, so browsers may cache them for a year.
    # A missing file must be a real 404 (not index.html), or the browser would try to run HTML as JS.
    location ~* \.(?:js|css|woff2?|ttf|svg|png|jpg|webp|ico)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # ---- The app itself ----
    # Any other path (/flights, /trips/42 ...) is a route inside the Angular app, so serve index.html.
    location / {
        try_files $uri $uri/ /index.html;

        # index.html must always be revalidated, so users get new releases straight away.
        add_header Cache-Control "no-cache";

        # Put this request's random nonce into the page (see ngCspNonce in src/index.html).
        sub_filter_once off;
        sub_filter "CSP_NONCE" $request_id;

        include /etc/nginx/snippets/security-headers.conf;
    }
}
