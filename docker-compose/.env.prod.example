# Production settings for docker-compose.prod.yml. On the server, copy this file to .env, then fill it in
# (or run scripts/generate-prod-env.sh, which fills in the generated secrets for you).
# Keep the real file readable by root only:  chmod 600 .env.  Never commit it.

# --- Public address: the only place the server's URL is configured ---
# Hostname without https://, e.g. a free DuckDNS subdomain pointing at this server.
PUBLIC_HOSTNAME=baldevairways.duckdns.org
PUBLIC_BASE_URL=https://baldevairways.duckdns.org

# --- Images published by CI to GitHub Container Registry ---
# IMAGE_TAG: "main" = latest successful build of the main branch; or a commit SHA to pin/roll back.
IMAGE_REGISTRY=ghcr.io/baldev-sinh
IMAGE_TAG=main

# --- Generated secrets (scripts/generate-prod-env.sh creates these) ---
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
JWT_SECRET=
GRAFANA_ADMIN_PASSWORD=

# Password of the demo airlines' owner accounts created by scripts/seed-demo (generated).
DEMO_OWNER_PASSWORD=

# First system admin, created once on first startup. Use a real mailbox; change the password after login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Razorpay TEST mode (test cards and UPI only, no real money) ---
# Keys from the Razorpay dashboard (Test Mode > Account & Settings > API Keys).
# Webhook: https://<PUBLIC_HOSTNAME>/api/payments/webhooks/razorpay with the secret below,
# events payment_link.paid, payment_link.expired, payment_link.cancelled. Registered once; the URL never changes.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Leave empty: payments go to Razorpay. "payment-stub" would simulate payments and must never be used here.
PAYMENT_SPRING_PROFILES=

# --- Observability ---
TRACING_SAMPLING_PROBABILITY=0.1
# Monitoring containers (with --profile monitoring) scrape the service containers.
PROMETHEUS_TARGETS=compose
