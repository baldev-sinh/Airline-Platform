# Copy to .env (git-ignored) and fill in. Never commit real values.
# Generate strong values with e.g.:  openssl rand -base64 48

# --- Databases ---
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=

# --- Auth: shared by api-gateway and user-service, at least 32 bytes ---
JWT_SECRET=

# Optional: creates the first system admin on startup if the account does not exist.
# Unset both after the first login and rotate the password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Payments (Razorpay test-mode keys for non-production) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_CALLBACK_BASE_URL=http://localhost:5173

# --- Edge ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Images (see `mvn jib:build -Dimage.registry=... -Dimage.tag=...`) ---
IMAGE_REGISTRY=baldevsinh
IMAGE_TAG=0.0.1-SNAPSHOT

# --- Observability ---
TRACING_SAMPLING_PROBABILITY=0.1
