# Copy to .env (git-ignored) and fill in. Never commit real values.
# Generate strong values with e.g.:  openssl rand -base64 48

# --- Databases ---
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=

# --- Central configuration: password services use to read config-server ---
CONFIG_SERVER_PASSWORD=

# --- Redis: cache, gateway rate limits, token revocations ---
REDIS_PASSWORD=

# --- Auth: RS256 private key that signs access tokens (user-service only; everyone else uses its public JWKS) ---
# One line with \n escapes. Create one with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | awk 'NF {printf "%s\\n", $0}'
JWT_PRIVATE_KEY=

# Optional: creates the first system admin on startup if the account does not exist.
# Unset both after the first login and rotate the password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Payments (Razorpay test-mode keys for non-production) ---
# Razorpay TEST mode: put your rzp_test_... key id and secret and your webhook secret here, then run
# `scripts/start-local.ps1 -RealPayments`, which reads them from this file. Step by step: docs/RAZORPAY_TEST_MODE.md
# No Razorpay account? Use the offline stub instead (local testing only, never production):
#   PAYMENT_SPRING_PROFILES=payment-stub
#   RAZORPAY_KEY_ID=rzp_test_stub
#   RAZORPAY_KEY_SECRET=stub
#   RAZORPAY_WEBHOOK_SECRET=local-stub-webhook-secret   (Postman signs webhooks with this value)
PAYMENT_SPRING_PROFILES=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_CALLBACK_BASE_URL=http://localhost:5173

# --- Demo data (optional): password of the demo airlines' owner accounts, see scripts/seed-demo ---
DEMO_OWNER_PASSWORD=

# --- ngrok (optional): permanent public address for Razorpay webhooks to reach this machine ---
# Used by `scripts/start-local.ps1 -RealPayments -Tunnel`. Free account at ngrok.com; see docs/RAZORPAY_TEST_MODE.md.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# --- E-mail (notification-service). Locally Mailpit catches everything: http://localhost:8025 ---
NOTIFICATION_FROM=no-reply@airline.local
PUBLIC_BASE_URL=http://localhost:5173

# --- Edge ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Images (see `mvn jib:build -Dimage.registry=... -Dimage.tag=...`) ---
IMAGE_REGISTRY=baldevsinh
IMAGE_TAG=0.0.1-SNAPSHOT

# --- Observability ---
# Traces go to the OpenTelemetry Collector, then Tempo; see them in Grafana (Explore > Tempo).
TRACING_EXPORT_ENABLED=true
# Locally, keep every trace (1.0). In production a fraction is enough (0.1 = 10 %).
TRACING_SAMPLING_PROBABILITY=1.0
# Grafana login (user: admin) at http://localhost:3000.
GRAFANA_ADMIN_PASSWORD=
# Where Prometheus finds the services: host (started by scripts/start-local.ps1) or compose (containers).
PROMETHEUS_TARGETS=host
