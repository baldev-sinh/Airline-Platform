l><mxCell id="calls-26" value="airline of owner" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0d6b8f;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#0d6b8f;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;curved=1;" edge="1" parent="1" source="calls-6" target="calls-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="calls-27" value="flight owner" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0d6b8f;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#0d6b8f;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;curved=1;" edge="1" parent="1" source="calls-6" target="calls-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="calls-28" value="user name + e-mail (/internal)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0d6b8f;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#0d6b8f;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;curved=1;" edge="1" parent="1" source="calls-7" target="calls-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="calls-29" value="GET /.well-known/jwks.json (cached 10 min)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#566573;strokeWidth=1;dashed=1;dashPattern=2 3;endArrow=open;fontColor=#566573;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="calls-11" target="calls-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="calls-30" value="/api/** is routed by the gateway and every service re-verifies the JWT there. /internal/** is never routed by the gateway; only services on the private network reach it. Each caller keeps its own copy of the response DTOs (&lt;service&gt;.client.dto)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#566573;" vertex="1" parent="1"><mxGeometry x="24" y="900" width="1050" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
