<mxfile host="app.diagrams.net" type="device"><diagram id="map" name="1. System map"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="map-1" value="Airline Platform: system map" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#14202c;" vertex="1" parent="1"><mxGeometry x="24" y="0" width="600" height="30" as="geometry"/></mxCell><mxCell id="map-2" value="&lt;b&gt;Browser: Angular SPA&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#566573'&gt;:5173 locally&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f3f5f7;strokeColor=#566573;dashed=1;fontColor=#14202c;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="50" width="300" height="50" as="geometry"/></mxCell><mxCell id="map-3" value="&lt;b&gt;config-server&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#566573'&gt;:8888&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#566573'&gt;serves config-repo/ to all 11 apps at boot&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e2f0f6;strokeColor=#0d6b8f;fontColor=#14202c;fontSize=12;" vertex="1" parent="1"><mxGeometry x="24" y="150" width="170" height="90" as="geometry"/></mxCell><mxCell id="map-4" value="&lt;b&gt;service-registry&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#566573'&gt;:8761 Eureka&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#566573'&gt;every app registers, lb://name lookup&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e2f0f6;strokeColor=#0d6b8f;fontColor=#14202c;fontSize=12;" vertex="1" parent="1"><mxGeometry x="214" y="150" width="150" height="90" as="geometry"/></mxCell><mxCell id="map-5" value="&lt;b&gt;api-gateway&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#566573'&gt;:5000, management :5100&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#566573'&gt;CORS → rate limit → verify JWT (JWKS) → AccessPolicy → route&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#566573'&gt;strips client X-User-* headers, adds the verified identity&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#14202c;fontColor=#14202c;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="390" y="150" width="380" height="90" as="geometry"/></mxCell><mxCell id="map-6" value="&lt;b&gt;Redis 8&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#566573'&gt;rate-limit buckets (Lua)&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#566573'&gt;token revocations&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#566573'&gt;@Cacheable reference data&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e2f0f6;strokeColor=#0d6b8f;fontColor=#14202c;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="150" width="170" height="90" as="geometry"/></mxCell><mxCell id="map-7" value="&lt;b&gt;user-service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#566573'&gt;:5001&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#566573'&gt;airline_user_db&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#14202c;fontColor=#14202c;fontSize=12;" vertex="1" parent="1"><mxGeometry x="24" y="330" width="112" height="80" as="geometry"/></mxCell><mxCell id="map-8" value="&lt;b&gt;airline-core-service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#566573'&gt;:5002&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#566573'&gt;airline_core_db&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#14202c;fontColor=#14202c;fontSize=12;" vertex="1" parent="1"><mxGeometry x="146" y="330" width="112" height="80" as="geometry"/></m